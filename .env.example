# Remote ML GPU Platform — Environment Configuration
# Copy this file to .env and modify values as needed.
# NEVER commit .env to Git.

# Host configuration
GPU_PLATFORM_HOST=0.0.0.0
GPU_PLATFORM_PORT=8765
GPU_PLATFORM_WORKERS=1

# Security — generated on first run if not set
# GPU_PLATFORM_SECRET_KEY=<auto-generated>
# GPU_PLATFORM_API_TOKEN=<auto-generated>

# Storage roots
GPU_PLATFORM_DATA_DIR=./data
GPU_PLATFORM_JOBS_DIR=./data/jobs
GPU_PLATFORM_DATASETS_DIR=./data/datasets
GPU_PLATFORM_MODELS_DIR=./data/models
GPU_PLATFORM_CHECKPOINTS_DIR=./data/checkpoints
GPU_PLATFORM_ARTIFACTS_DIR=./data/artifacts

# Database
GPU_PLATFORM_DATABASE_URL=sqlite:///./data/platform.db

# Scheduler
GPU_PLATFORM_MAX_CONCURRENT_JOBS=1

# GPU
GPU_PLATFORM_ALLOWED_DEVICES=0

# Uploads
GPU_PLATFORM_MAX_UPLOAD_SIZE_MB=10240

# Logging
GPU_PLATFORM_LOG_LEVEL=INFO

# LAN Discovery
GPU_PLATFORM_DISCOVERY_ENABLED=true
GPU_PLATFORM_SERVICE_NAME=_gpu-ml-platform._tcp.local.
